{
  "expo": {
    "name": "Lumio",
    "slug": "Lumio",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lumio",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "icon": "./assets/images/icon.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.lumiojournal.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Lumio uses Face ID to confirm it’s you before opening your journal and chat."
      }
    },
    "android": {
      "package": "com.lumiojournal.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#A8C4CA",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Lumio uses Face ID to confirm it’s you before opening your journal and chat."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#EEF6F8",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "08f8b744-a5ae-49a0-b7ff-410be542e89d"
      }
    }
  }
}
